# Copy this file to .env and fill in your own keys. Do not commit .env.
#   Finnhub: https://finnhub.io/
FINNHUB_API_KEY=

# SEC requires no API key, but its fair-use policy requires every request to
# identify a real contact via User-Agent. Must be quoted here since it
# contains spaces.
SEC_USER_AGENT="Your Name your@email.com"

# FMP was retired to backup/fmp.js on 2026-08-10 (see that file's header) - it
# was quota-exhausted on every run and contributed zero real data. Only
# uncomment this if you re-enable FMP (e.g. after adding a paid FMP tier)
# and restore providers/fmp.js.
# FMP_API_KEY=
