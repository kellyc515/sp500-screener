# Copy this file to .env and fill in your own keys. Do not commit .env.
#   Finnhub: https://finnhub.io/
FINNHUB_API_KEY=

# SEC requires no API key, but its fair-use policy requires every request to
# identify a real contact via User-Agent. Must be quoted here since it
# contains spaces.
SEC_USER_AGENT="Your Name your@email.com"

# FMP's old per-ticker fundamentals use (backup/fmp.js) was retired
# 2026-08-10 for quota exhaustion. providers/fmpCongress.js is a separate,
# unrelated use: 2 bulk calls per run (Senate + House trade disclosures via
# https://financialmodelingprep.com/stable/senate-latest and house-latest),
# nowhere near the 250/day free quota. Get a free key at
# https://site.financialmodelingprep.com/
FMP_API_KEY=
